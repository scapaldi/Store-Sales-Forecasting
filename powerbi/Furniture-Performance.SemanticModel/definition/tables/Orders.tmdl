table Orders
	lineageTag: 4f6e1c2a-8b33-4d17-9a55-71c0e6b2d441

	measure 'Total Sales' = SUM ( Orders[Sales] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 1ad87119-6f9d-99c8-36e1-cf3ae6290000

	measure 'Total Profit' = SUM ( Orders[Profit] )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: f780892e-45eb-d38f-4c64-1ebf6f720000

	measure 'Margin %' = DIVIDE ( [Total Profit], [Total Sales] )
		formatString: 0.0%
		lineageTag: d78b01f0-52ec-af32-e32c-58b20cc40000

	measure 'Orders' = DISTINCTCOUNT ( Orders[Order ID] )
		formatString: #,0
		lineageTag: ad0275c2-cded-0933-21dd-aa4c0eaf0000

	measure 'Avg Discount' = AVERAGE ( Orders[Discount] )
		formatString: 0.0%
		lineageTag: a0b9e6a7-8b37-7601-0baf-a809438a0000

	measure 'Weighted Discount' = DIVIDE ( SUMX ( Orders, Orders[Sales] * Orders[Discount] ), [Total Sales] )
		formatString: 0.0%
		lineageTag: aa44c3e6-c8d8-9016-8c28-1adb6d5a0000

	measure 'Line Count' = COUNTROWS ( Orders )
		formatString: #,0
		lineageTag: 5527cd18-4e27-9c84-0887-7cfae9340000

	measure 'Avg Qty per Order' = DIVIDE ( SUM ( Orders[Quantity] ), [Orders] )
		formatString: 0.0
		lineageTag: 2d9d309c-3548-365e-33b4-47f806fa0000

	measure 'Avg Ship Time' = AVERAGEX ( VALUES ( Orders[Order ID] ), CALCULATE ( AVERAGE ( Orders[Ship Days] ) ) )
		formatString: 0.0
		lineageTag: e15502d3-4537-4bbf-b65c-e43bbb460000

	measure 'Orders This Year' = CALCULATE ( [Orders], REMOVEFILTERS ( Orders[Year] ), Orders[Year] = 2017 )
		formatString: #,0
		lineageTag: 7e0ce386-95a4-98b9-ecdb-9556a1340000

